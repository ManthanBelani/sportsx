APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_PROVIDER=smtp
MAIL_FAILOVER_ENABLED=true
MAIL_FAILOVER_RETRY_AFTER=60
MAIL_TEST_RECIPIENT=
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Gmail API transport (MAIL_PROVIDER=gmail or failover chain)
GMAIL_AUTH_MODE=user
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=
GMAIL_REFRESH_TOKEN=
GMAIL_SERVICE_ACCOUNT_JSON=
GMAIL_IMPERSONATED_USER=

FRONTEND_URL=http://localhost:3000

# Google Sign-In (ID-token verification)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_ALLOW_SIGNUP=true
GOOGLE_DEFAULT_ROLE=athlete
GOOGLE_ALLOWED_ROLES=athlete,coach,academy,organizer,scout,talent_scout
GOOGLE_WORKSPACE_HD=

# Admin 2FA (TOTP, pure-PHP — no extra composer dep)
# true in production/staging; false only for local dev seed + phpunit (phpunit.xml already sets false).
ADMIN_2FA_ENFORCE=true

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Sentry Exception Tracking
SENTRY_DSN=
SENTRY_ENABLED=false
SENTRY_TRACING_ENABLED=true
SENTRY_TRACING_SAMPLE_RATE=0.1

# Firebase Cloud Messaging (FCM) for Push Notifications
FCM_ENABLED=true
FCM_PROJECT_ID=
FCM_CREDENTIALS_PATH=
FCM_TIMEOUT=15
FCM_BATCH_SIZE=500
FCM_MAX_RETRIES=3
FCM_DRY_RUN=false
FCM_DEFAULT_CHANNEL_ID=sportx_default
FCM_TOPIC_BROADCAST=sportx_broadcast
FCM_TOPIC_SPORT=sportx_sport
DEVICE_TOKEN_TTL_DAYS=120
NOTIFICATION_RETENTION_DAYS=180
CHAT_RETENTION_DAYS=90

# Horizon Queue Management
HORIZON_BRANCH=main

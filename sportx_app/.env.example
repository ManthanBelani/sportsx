# ─────────────────────────────────────────────────────────────
# SportX India — Mobile App Environment Configuration
# ─────────────────────────────────────────────────────────────
# Copy this file to `.env` and adjust the values for your setup.
#   cp .env.example .env
#
# After changing `.env`, do a full app restart (hot reload is NOT
# enough — the .env is loaded once at startup).
#
# Examples for API_BASE_URL:
#   Local emulator:     http://10.0.2.2:8002/api/v1
#   Physical device:    http://192.168.1.10:8002/api/v1
#   Production:         https://api.sportx.in/api/v1
# ─────────────────────────────────────────────────────────────

# Base URL of the SportX backend API (must include the /api/v1 prefix)
API_BASE_URL=http://127.0.0.1:8002/api/v1

# Public web app URL (used for share links / deep links)
WEB_BASE_URL=https://sportx.in

# Request timeouts (in seconds)
API_CONNECT_TIMEOUT_SECONDS=30
API_RECEIVE_TIMEOUT_SECONDS=30
